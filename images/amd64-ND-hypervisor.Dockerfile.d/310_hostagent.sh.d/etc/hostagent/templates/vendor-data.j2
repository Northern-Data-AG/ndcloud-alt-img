# Default config from ND-hypervisor image

#cloud-config
chpasswd:
  expire: false
disable_root: true
fqdn: cloudvm.example.com
hostname: cloudvm
manage_etc_hosts: true
package_update: true
packages:
- qemu-guest-agent
- wget
- gnupg2
{% if "debian" in image["tags"] or "ubuntu" in image["tags"] %}
- ufw
{% endif %}
{% if "centos" in image["tags"] or "rocky" in image["tags"] %}
- firewalld
{% endif %}
ssh_pwauth: false
runcmd:
- rm /etc/update-motd.d/10-help-text
- rm /etc/update-motd.d/50-motd-news
{% if "ubuntu" not in image["tags"] %}
- systemctl disable --now systemd-resolved
{% endif %}
{% if "debian" in image["tags"] or "ubuntu" in image["tags"] %}
- ufw allow ssh
- ufw allow http
- ufw allow https
- ufw default deny
- ufw --force enable
- ufw reload
{% endif %}
{% if "centos" in image["tags"] or "rocky" in image["tags"] %}
- systemctl enable --now firewalld
- firewall-cmd --permanent --zone=external --add-service=ssh
- firewall-cmd --permanent --zone=external --add-service=http
- firewall-cmd --permanent --zone=external --add-service=https
- firewall-cmd --reload
{% endif %}
users:
- groups: users, admin, video
{% if "centos" in image["tags"] %}
  name: centos
  home: /home/centos
{% elif "debian" in image["tags"] %}
  name: debian
  home: /home/debian
{% elif "rocky" in image["tags"] %}
  name: rockstar
  home: /home/rockstar
{% elif "ubuntu" in image["tags"] %}
  name: ubuntu
  home: /home/ubuntu
{% else %}
  name: clouduser
  home: /home/clouduser
{% endif %}
  lock_passwd: false
  shell: /bin/bash
  ssh_authorized_keys:
{% for sshkey in sshkeys %}
  - {{ sshkey }}
{% endfor %}
  sudo: ALL=(ALL) NOPASSWD:ALL
write_files:
{% if "ubuntu" not in image["tags"] %}
- path: /etc/resolv.conf
  encoding: b64
  content: IyBOb3J0aGVybiBEYXRhIG5hbWVzZXJ2ZXJzCm5hbWVzZXJ2ZXIgMmEwYjpkNDA6MDoyOjozCm5hbWVzZXJ2ZXIgMmEwYjpkNDA6MDoyOjo0Cg==
  owner: root:root
  permissions: '0644'
{% endif %}
- path: /etc/update-motd.d/nd-logo
  content: 
  permissions: '0644'
- path: /etc/update-motd.d/10-nd-logo
  content: '#!/bin/bash

    base64 -d < /etc/update-motd.d/nd-logo.b64'
  permissions: '0755'
- path: /etc/default/grub.d/60-ndcloud-settings.cfg
  content: '# Northern Data cloud specific settings

    GRUB_TIMEOUT=15

    GRUB_CMDLINE_LINUX_DEFAULT="console=tty1 console=ttyS0 pcie_aspm=off"

    GRUB_TERMINAL=console'
  permissions: '0755'
- path: /etc/update-motd.d/99-ufw-warning
  content: "#!/bin/bash\necho -e \"\e[0;33m[Notice] ufw (a simple firewall) is active\
    \ by default on this system.\e[0m\"\necho \"Use \"sudo ufw status\" to check the\
    \ status and read the documentation on ufw before proceeding.\"\necho \"Only ports\
    \ 22 (SSH), 80 (HTTP) and 443 (HTTPS) are publicly available by default\"\necho\
    \ \n"
  permissions: '0755'
